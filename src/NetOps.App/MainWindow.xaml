<Window x:Class="NetOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOps Toolbox" Height="820" Width="1180" MinHeight="560" MinWidth="900"
        Background="{StaticResource BgCanvas}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <TextBlock Text="NETOPS TOOLBOX" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        <Border HorizontalAlignment="Right" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Padding="8,4">
          <TextBlock Text="ADMIN" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
        </Border>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock x:Name="StatusText" Text="NetOps Toolbox · Minimal Mono" FontSize="11" Foreground="{StaticResource TextMuted}"/>
    </Border>
    <Border DockPanel.Dock="Left" Width="170" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Padding="14,20">
      <StackPanel>
        <Button Content="Dashboard" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click"/>
        <Button Content="Devices" Style="{StaticResource NavButton}" Tag="Devices" Click="Nav_Click"/>
        <Button Content="Jobs" Style="{StaticResource NavButton}" Tag="Jobs" Click="Nav_Click"/>
        <Button Content="Diagnose" Style="{StaticResource NavButton}" Tag="Diagnose" Click="Nav_Click"/>
        <Button Content="Tools" Style="{StaticResource NavButton}" Tag="Tools" Click="Nav_Click"/>
        <Button Content="Firmware" Style="{StaticResource NavButton}" Tag="Firmware" Click="Nav_Click"/>
        <Button Content="Security" Style="{StaticResource NavButton}" Tag="Security" Click="Nav_Click"/>
        <Button Content="Playbooks" Style="{StaticResource NavButton}" Tag="Playbooks" Click="Nav_Click"/>
        <Button Content="Reports" Style="{StaticResource NavButton}" Tag="Reports" Click="Nav_Click"/>
        <Button Content="Settings" Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click"/>
      </StackPanel>
    </Border>
    <Grid Margin="24,18">
      <StackPanel x:Name="ContentDashboard">
        <TextBlock Text="RECENT JOBS" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
        <TextBlock x:Name="JobsText" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
      </StackPanel>

      <DockPanel x:Name="ContentDevices" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="BrandBox" Width="120" Margin="0,0,6,0"/>
            <ComboBox x:Name="ModelBox" Width="140" Margin="0,0,6,0"/>
            <TextBox x:Name="IpBox" Width="120" Margin="0,0,6,0" FontFamily="Consolas" Text="192.168.1.1"/>
            <Button Content="Add" Padding="10,5" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="AddDevice_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBox x:Name="SshUserBox" Width="80" Margin="0,0,6,0" Text="admin"/>
            <PasswordBox x:Name="SshPassBox" Width="100" Margin="0,0,6,0" ToolTip="Login password"/>
            <PasswordBox x:Name="EnablePassBox" Width="100" Margin="0,0,6,0" ToolTip="Cisco enable (optional)"/>
            <TextBox x:Name="SshPortBox" Width="40" Margin="0,0,6,0" FontFamily="Consolas" Text="22"/>
            <Button Content="Save vault" Padding="8,5" Margin="0,0,4,0" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="VaultSave_Click"/>
            <Button Content="Load" Padding="8,5" Margin="0,0,4,0" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="VaultLoad_Click"/>
            <Button Content="Delete" Padding="8,5" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="VaultDelete_Click"/>
          </StackPanel>
          <WrapPanel Margin="0,0,0,6">
            <Button Content="MT Test" Padding="8,5" Margin="0,0,4,4" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="MikrotikTest_Click"/>
            <Button Content="MT Export" Padding="8,5" Margin="0,0,4,4" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="MikrotikBackup_Click"/>
            <Button Content="Cisco Ver" Padding="8,5" Margin="0,0,4,4" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="CiscoVersion_Click"/>
            <Button Content="Cisco Run" Padding="8,5" Margin="0,0,4,4" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="CiscoShowRun_Click"/>
            <Button Content="UBNT ID" Padding="8,5" Margin="0,0,4,4" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="UbntId_Click"/>
            <Button Content="UBNT Export" Padding="8,5" Margin="0,0,4,4" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="UbntExport_Click"/>
            <Button Content="Refresh vault" Padding="8,5" Margin="0,0,4,4" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="VaultRefresh_Click"/>
          </WrapPanel>
          <TextBlock Text="VAULT" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
          <ListBox x:Name="VaultList" Height="80" BorderBrush="{StaticResource Stroke}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6" MouseDoubleClick="VaultList_DoubleClick"/>
          <ListBox x:Name="DeviceList" Height="48" BorderBrush="{StaticResource Stroke}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
        </StackPanel>
        <ScrollViewer>
          <TextBlock x:Name="DeviceSshOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"
                     Text="MT / Cisco / Ubiquiti SSH. Queue multi-device backups from Jobs tab."/>
        </ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentJobs" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <TextBlock Text="Queue backups for all vault entries (or selected). Max concurrency = 2." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <WrapPanel>
            <Button Content="Queue: MT Export all" Padding="10,6" Margin="0,0,6,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="QueueMtAll_Click"/>
            <Button Content="Queue: Cisco Run all" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="QueueCiscoAll_Click"/>
            <Button Content="Queue: UBNT Export all" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="QueueUbntAll_Click"/>
            <Button Content="Refresh jobs" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="JobsRefresh_Click"/>
          </WrapPanel>
        </StackPanel>
        <ScrollViewer>
          <TextBlock x:Name="JobsPanelText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="No jobs yet."/>
        </ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentDiagnose" Visibility="Collapsed">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button Content="Run diagnosis" Padding="12,7" Margin="0,0,8,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="RunDiagnose_Click"/>
          <Button Content="Flush DNS" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ApplyFlushDns_Click"/>
          <Button Content="Renew DHCP" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ApplyRenewDhcp_Click"/>
          <Button Content="Set DNS 1.1.1.1" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ApplySetDns_Click"/>
          <TextBlock x:Name="DiagnoseBusy" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
        </WrapPanel>
        <ScrollViewer><TextBlock x:Name="DiagnoseOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="Diagnose."/></ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentTools" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox x:Name="ToolsInput" FontFamily="Consolas" Margin="0,0,0,8" Text="1.1.1.1, 8.8.8.8"/>
          <WrapPanel>
            <Button Content="Ping" Padding="10,6" Margin="0,0,6,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="ToolPing_Click"/>
            <Button Content="DNS" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ToolDns_Click"/>
            <Button Content="Port" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ToolPort_Click"/>
            <Button Content="Traceroute" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ToolTrace_Click"/>
            <Button Content="Subnet" Padding="10,6" Margin="0,0,6,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ToolSubnet_Click"/>
          </WrapPanel>
        </StackPanel>
        <ScrollViewer><TextBlock x:Name="ToolsOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="Ready."/></ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentFirmware" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox x:Name="FwVersionBox" Margin="0,0,0,8" FontFamily="Consolas" Text="(optional current version)"/>
          <Button Content="Diagnose firmware" Padding="12,7" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" HorizontalAlignment="Left" Click="FirmwareDiagnose_Click"/>
        </StackPanel>
        <ScrollViewer><TextBlock x:Name="FirmwareOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="Firmware."/></ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentSecurity" Visibility="Collapsed">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Content="Scan LAN" Padding="12,7" Margin="0,0,8,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="SecurityScan_Click"/>
          <Button Content="Save baseline" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="SecuritySave_Click"/>
          <Button Content="Diff vs baseline" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="SecurityDiff_Click"/>
        </WrapPanel>
        <ScrollViewer><TextBlock x:Name="SecurityOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="LAN."/></ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentPlaybooks" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <ComboBox x:Name="PlaybookBox" Margin="0,0,0,8"/>
          <Button Content="Show playbook" Padding="12,7" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" HorizontalAlignment="Left" Click="PlaybookShow_Click"/>
        </StackPanel>
        <ScrollViewer><TextBlock x:Name="PlaybookOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="Playbooks."/></ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentReports" Visibility="Collapsed">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Content="Generate" Padding="12,7" Margin="0,0,8,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="ReportGenerate_Click"/>
          <Button Content="Save TXT" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ReportSave_Click"/>
          <Button Content="Save CSV" Padding="12,7" Margin="0,0,8,6" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Click="ReportSaveCsv_Click"/>
        </WrapPanel>
        <ScrollViewer><TextBlock x:Name="ReportOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Text="Reports."/></ScrollViewer>
      </DockPanel>

      <TextBlock x:Name="ContentOther" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="14"/>
    </Grid>
  </DockPanel>
</Window>
