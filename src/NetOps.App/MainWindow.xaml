<Window x:Class="NetOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOps Toolbox"
        Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        Background="{StaticResource BgCanvas}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <TextBlock Text="NETOPS TOOLBOX" FontWeight="SemiBold" FontSize="14" LetterSpacing="1" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        <Border HorizontalAlignment="Right" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Padding="8,4">
          <TextBlock Text="ADMIN" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock x:Name="StatusText" Text="NetOps Toolbox · Minimal Mono · Elevated session" FontSize="11" Foreground="{StaticResource TextMuted}"/>
    </Border>

    <Border DockPanel.Dock="Left" Width="180" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Padding="16,24">
      <StackPanel x:Name="NavPanel">
        <Button Content="Dashboard" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click"/>
        <Button Content="Devices" Style="{StaticResource NavButton}" Tag="Devices" Click="Nav_Click"/>
        <Button Content="Tools" Style="{StaticResource NavButton}" Tag="Tools" Click="Nav_Click"/>
        <Button Content="Firmware" Style="{StaticResource NavButton}" Tag="Firmware" Click="Nav_Click"/>
        <Button Content="Security" Style="{StaticResource NavButton}" Tag="Security" Click="Nav_Click"/>
        <Button Content="Playbooks" Style="{StaticResource NavButton}" Tag="Playbooks" Click="Nav_Click"/>
        <Button Content="Reports" Style="{StaticResource NavButton}" Tag="Reports" Click="Nav_Click"/>
        <Button Content="Settings" Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click"/>
      </StackPanel>
    </Border>

    <Grid Margin="28,24">
      <StackPanel x:Name="ContentDashboard">
        <UniformGrid Columns="4" Margin="0,0,0,24">
          <Border Background="{StaticResource BgInverse}" Padding="14" Margin="0,0,8,0" MinHeight="90">
            <StackPanel>
              <TextBlock Text="LATENCY" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="12 ms" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="gateway" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource BgInverse}" Padding="14" Margin="0,0,8,0" MinHeight="90">
            <StackPanel>
              <TextBlock Text="LOSS" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="0%" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="last 60s" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource BgInverse}" Padding="14" Margin="0,0,8,0" MinHeight="90">
            <StackPanel>
              <TextBlock Text="THROUGHPUT" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="84 Mb" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="down approx" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource BgInverse}" Padding="14" MinHeight="90">
            <StackPanel>
              <TextBlock Text="ALERTS" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="1" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="new host" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <TextBlock Text="RECENT JOBS" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
        <TextBlock x:Name="JobsText" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
      </StackPanel>

      <StackPanel x:Name="ContentDevices" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <ComboBox x:Name="BrandBox" Width="160" Margin="0,0,8,0"/>
          <ComboBox x:Name="ModelBox" Width="200" Margin="0,0,8,0"/>
          <TextBox x:Name="IpBox" Width="140" Margin="0,0,8,0" FontFamily="Consolas"/>
          <Button Content="Add device" Padding="12,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="AddDevice_Click"/>
        </StackPanel>
        <ListBox x:Name="DeviceList" BorderBrush="{StaticResource Stroke}" FontFamily="Consolas" FontSize="12"/>
      </StackPanel>

      <TextBlock x:Name="ContentOther" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="14"/>
    </Grid>
  </DockPanel>
</Window>
