<Window x:Class="NetOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOps Toolbox" Height="720" Width="1100"
        Background="{StaticResource BgApp}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/MinimalMono.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="NETOPS TOOLBOX" FontSize="16" FontWeight="SemiBold" LetterSpacing="1"/>
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="NetOps Toolbox · Minimal Mono" FontSize="11" Foreground="{StaticResource TextMuted}"/>
      </Grid>
    </Border>
    <ScrollViewer DockPanel.Dock="Left" Width="160" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8">
        <Button Content="Dashboard" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click"/>
        <Button Content="Monitor" Style="{StaticResource NavButton}" Tag="Monitor" Click="Nav_Click"/>
        <Button Content="Scan" Style="{StaticResource NavButton}" Tag="Scan" Click="Nav_Click"/>
        <Button Content="Devices" Style="{StaticResource NavButton}" Tag="Devices" Click="Nav_Click"/>
        <Button Content="Jobs" Style="{StaticResource NavButton}" Tag="Jobs" Click="Nav_Click"/>
        <Button Content="Diagnose" Style="{StaticResource NavButton}" Tag="Diagnose" Click="Nav_Click"/>
        <Button Content="Tools" Style="{StaticResource NavButton}" Tag="Tools" Click="Nav_Click"/>
        <Button Content="Firmware" Style="{StaticResource NavButton}" Tag="Firmware" Click="Nav_Click"/>
        <Button Content="Security" Style="{StaticResource NavButton}" Tag="Security" Click="Nav_Click"/>
        <Button Content="Playbooks" Style="{StaticResource NavButton}" Tag="Playbooks" Click="Nav_Click"/>
        <Button Content="Reports" Style="{StaticResource NavButton}" Tag="Reports" Click="Nav_Click"/>
        <Button Content="Defaults" Style="{StaticResource NavButton}" Tag="Defaults" Click="Nav_Click"/>
        <Button Content="Tweaks" Style="{StaticResource NavButton}" Tag="Tweaks" Click="Nav_Click"/>
      </StackPanel>
    </ScrollViewer>
    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="20">
      <Grid>
        <!-- content panels injected by code visibility -->
        <ContentControl x:Name="_placeholder_note" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
