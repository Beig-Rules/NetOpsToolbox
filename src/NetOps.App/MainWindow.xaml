<Window x:Class="NetOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOps Toolbox"
        Height="720" Width="1080"
        MinHeight="480" MinWidth="800"
        Background="{StaticResource BgCanvas}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid>
        <TextBlock Text="NETOPS TOOLBOX" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        <Border HorizontalAlignment="Right" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Padding="8,4">
          <TextBlock Text="ADMIN" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
        </Border>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock x:Name="StatusText" Text="NetOps Toolbox · Minimal Mono · Elevated session" FontSize="11" Foreground="{StaticResource TextMuted}"/>
    </Border>
    <Border DockPanel.Dock="Left" Width="180" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Padding="16,24">
      <StackPanel>
        <Button Content="Dashboard" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click"/>
        <Button Content="Devices" Style="{StaticResource NavButton}" Tag="Devices" Click="Nav_Click"/>
        <Button Content="Diagnose" Style="{StaticResource NavButton}" Tag="Diagnose" Click="Nav_Click"/>
        <Button Content="Tools" Style="{StaticResource NavButton}" Tag="Tools" Click="Nav_Click"/>
        <Button Content="Firmware" Style="{StaticResource NavButton}" Tag="Firmware" Click="Nav_Click"/>
        <Button Content="Security" Style="{StaticResource NavButton}" Tag="Security" Click="Nav_Click"/>
        <Button Content="Playbooks" Style="{StaticResource NavButton}" Tag="Playbooks" Click="Nav_Click"/>
        <Button Content="Reports" Style="{StaticResource NavButton}" Tag="Reports" Click="Nav_Click"/>
        <Button Content="Settings" Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click"/>
      </StackPanel>
    </Border>
    <Grid Margin="28,24">
      <StackPanel x:Name="ContentDashboard">
        <UniformGrid Columns="4" Margin="0,0,0,24">
          <Border Background="{StaticResource BgInverse}" Padding="14" Margin="0,0,8,0" MinHeight="90">
            <StackPanel>
              <TextBlock Text="LATENCY" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="—" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="use Tools" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource BgInverse}" Padding="14" Margin="0,0,8,0" MinHeight="90">
            <StackPanel>
              <TextBlock Text="ACTIONS" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="Live" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="flush · renew" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource BgInverse}" Padding="14" Margin="0,0,8,0" MinHeight="90">
            <StackPanel>
              <TextBlock Text="TOOLS" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="5" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="ping dns port…" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource BgInverse}" Padding="14" MinHeight="90">
            <StackPanel>
              <TextBlock Text="FLOWS" FontSize="10" Foreground="{StaticResource TextOnInverse}" Opacity="0.7"/>
              <TextBlock Text="4" FontSize="22" Foreground="{StaticResource TextOnInverse}" Margin="0,6,0,0"/>
              <TextBlock Text="diagnosis" FontSize="11" Foreground="{StaticResource TextOnInverse}" Opacity="0.65"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <TextBlock Text="RECENT JOBS" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
        <TextBlock x:Name="JobsText" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
      </StackPanel>

      <StackPanel x:Name="ContentDevices" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <ComboBox x:Name="BrandBox" Width="160" Margin="0,0,8,0"/>
          <ComboBox x:Name="ModelBox" Width="200" Margin="0,0,8,0"/>
          <TextBox x:Name="IpBox" Width="140" Margin="0,0,8,0" FontFamily="Consolas"/>
          <Button Content="Add device" Padding="12,6" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="AddDevice_Click"/>
        </StackPanel>
        <ListBox x:Name="DeviceList" BorderBrush="{StaticResource Stroke}" FontFamily="Consolas" FontSize="12"/>
      </StackPanel>

      <DockPanel x:Name="ContentDiagnose" Visibility="Collapsed">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <Button x:Name="RunDiagnoseBtn" Content="Run diagnosis" Padding="14,8" Margin="0,0,8,8"
                  Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}"
                  BorderThickness="0" Click="RunDiagnose_Click"/>
          <Button Content="Apply: Flush DNS" Padding="14,8" Margin="0,0,8,8"
                  BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Background="{StaticResource BgSurface}"
                  Click="ApplyFlushDns_Click"/>
          <Button Content="Apply: Renew DHCP" Padding="14,8" Margin="0,0,8,8"
                  BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Background="{StaticResource BgSurface}"
                  Click="ApplyRenewDhcp_Click"/>
          <TextBlock x:Name="DiagnoseBusy" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="DiagnoseOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     Foreground="{StaticResource TextPrimary}"
                     Text="Collect → flows → solutions → Apply Flush DNS or Renew DHCP."/>
        </ScrollViewer>
      </DockPanel>

      <DockPanel x:Name="ContentTools" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBox x:Name="ToolsInput" FontFamily="Consolas" Margin="0,0,0,8"
                   Text="1.1.1.1, 8.8.8.8, gateway"/>
          <WrapPanel>
            <Button Content="Ping" Padding="12,6" Margin="0,0,8,8" Background="{StaticResource BgInverse}" Foreground="{StaticResource TextOnInverse}" BorderThickness="0" Click="ToolPing_Click"/>
            <Button Content="DNS" Padding="12,6" Margin="0,0,8,8" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Background="{StaticResource BgSurface}" Click="ToolDns_Click"/>
            <Button Content="Port" Padding="12,6" Margin="0,0,8,8" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Background="{StaticResource BgSurface}" Click="ToolPort_Click"/>
            <Button Content="Traceroute" Padding="12,6" Margin="0,0,8,8" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Background="{StaticResource BgSurface}" Click="ToolTrace_Click"/>
            <Button Content="Subnet" Padding="12,6" Margin="0,0,8,8" BorderBrush="{StaticResource TextPrimary}" BorderThickness="1" Background="{StaticResource BgSurface}" Click="ToolSubnet_Click"/>
          </WrapPanel>
          <TextBlock Text="Ping: hosts comma-separated · Port: host:port · Subnet: 192.168.1.0/24" FontSize="11" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ToolsOutput" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     Foreground="{StaticResource TextPrimary}" Text="Ready."/>
        </ScrollViewer>
      </DockPanel>

      <TextBlock x:Name="ContentOther" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="14"/>
    </Grid>
  </DockPanel>
</Window>
