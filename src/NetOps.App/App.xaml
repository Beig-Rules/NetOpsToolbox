<Application x:Class="NetOps.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgCanvas" Color="#F4F4F2"/>
    <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInverse" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="TextOnInverse" Color="#F4F4F2"/>
    <SolidColorBrush x:Key="Stroke" Color="#E2E2E0"/>
  </Application.Resources>
</Application>
